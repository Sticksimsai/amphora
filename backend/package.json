{
  "name": "amphora-backend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "api": "tsx src/api/server.ts",
    "worker:settler": "tsx src/workers/settler.ts",
    "worker:indexer": "tsx src/workers/indexerLoop.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "ladder": "tsx scripts/solveOdds.ts",
    "sync": "tsx scripts/sync.ts",
    "float": "tsx scripts/float-check.ts",
    "induct": "tsx scripts/induct.ts",
    "reprice": "tsx scripts/reprice.ts",
    "seed:setup": "tsx scripts/seed-root-setup.ts",
    "env:check": "awk -F= '/^[A-Z_]+=/{if (seen[$1]++) {print \"DUPLICATE: \"$1\" line \"NR; bad=1}} END{exit bad}' .env"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.38.2",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "postgres": "^3.4.5",
    "viem": "^2.21.55",
    "zod": "^3.24.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-kms": "^3.700.0"
  }
}
