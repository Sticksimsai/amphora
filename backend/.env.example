# Amphora backend — Elysium (Kinetiq's L2 for Hyperliquid). Everything is HYPE.
#
# AFTER EVERY EDIT, check for duplicate keys. dotenv takes the FIRST occurrence,
# so an empty duplicate above a good value breaks everything with no error.
# This caused three separate outages on the original deployment:
#   awk -F= '/^[A-Z_]+=/{if (seen[$1]++) print "DUPLICATE: "$1" line "NR}' .env

# ── network ─────────────────────────────────────────────────────────────
# TESTNET=true is the ONLY thing that selects testnet (99801). Leaving
# TESTNET_RPC_URL set does not, unlike the original.
TESTNET=true
RPC_URL=                      # mainnet 99901 — a KEYED provider (Alchemy / Chainstack / Goldsky / QuickNode)
TESTNET_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
LOG_CHUNK=2000                # your provider's eth_getLogs block-range limit (free tiers: as low as 100)
CATCHUP_BLOCKS=18000          # ~30 min at ~10 blocks/s

# ── contracts (printed by Deploy.s.sol) ─────────────────────────────────
VAULT_ADDRESS=
CERT_ADDRESS=
GACHA_ADDRESS=
FACTORY_ADDRESS=
MINT_ADDRESS=
FACTORY_START_BLOCK=          # block of the factory deploy tx

# ── identities: five, never one (docs/KEYS.md) ──────────────────────────
# ADMIN is a hardware wallet and has NO key here.
CURATOR_PRIVATE_KEY=          # curator / NAV / series / operator roles
CURATOR_ADDRESS=
SETTLER_PRIVATE_KEY=          # settler role. Holds gas only.
SETTLER_ADDRESS=
DESK_PRIVATE_KEY=             # DESK_ROLE + a bounded HYPE float
DESK_ADDRESS=
REDEEM_PRIVATE_KEY=           # REDEEM_ROLE
REDEEM_ADDRESS=
TREASURY_PRIVATE_KEY=         # hot treasury that refills the others (not the Safe)
TREASURY_ADDRESS=             # where box revenue lands
RESERVE_ADDRESS=              # acquisition reserve — Safe / multisig, no key here

# ── economics (HYPE) ────────────────────────────────────────────────────
BOX_PRICE_HYPE=0.5            # must equal machines(1).priceWei on-chain; run scripts/sync.ts
TREASURY_FLOOR_HYPE=20
DESK_TRIGGER_HYPE=3
DESK_TARGET_HYPE=10
SETTLER_TRIGGER_HYPE=0.05
SETTLER_TARGET_HYPE=0.25
SETTLER_GAS_WARN_HYPE=0.05

# ── seed custody ────────────────────────────────────────────────────────
SEED_PROVIDER=env             # aws-kms | systemd | env (env refuses to run in production)
ACTIVE_SEED_CHAIN_ID=

# ── infra ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://amphora:CHANGE_ME@127.0.0.1:5432/amphora
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
PORT=8080
FRONTEND_ORIGINS=https://amphora.example
ADMIN_TOKEN=
BLOCKED_COUNTRIES=GB,US,FR,BE,NL,AU,SG
REDEMPTION_OPEN=false

# ── token layer (optional; leave blank until $AMPH exists) ──────────────
LAUNCHPAD_NAME=citadel        # label only
TOKEN_ADDRESS=
POOL_ADDRESS=                 # the locked Uniswap V3 pool, quoted in HYPE
WHYPE_ADDRESS=                # read token0()/token1() off the pool; do not guess
POOL_START_BLOCK=
POOL_FEE=10000                # hundredths of a bip; the indexer re-reads pool.fee()
CREATOR_SHARE_BPS=7000        # YOUR launchpad's creator share of the pool fee — confirm it
TOKEN_SUPPLY=1000000000
SWAP_ROUTER=                  # Uniswap V3 SwapRouter02 on Elysium
BUYBACK_ENABLED=false         # read the note at the top of scripts/daily-buyback.ts first
OPERATING_SHARE=0.5
BUYBACK_SHARE=1.0
MAX_DAILY_BUY_HYPE=25
BUYBACK_SLIPPAGE_BPS=300
