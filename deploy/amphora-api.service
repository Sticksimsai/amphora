[Unit]
Description=Amphora API
After=network.target docker.service
[Service]
User=amphora
WorkingDirectory=/home/amphora/amphora/backend
EnvironmentFile=/home/amphora/amphora/backend/.env
ExecStart=/usr/bin/node --import tsx src/api/server.ts
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
